{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingoArifiye",
  "version": "1.0.0",
  "identifier": "com.salihbayrak.lingoarifiye",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      { "title": "Lingo Arifiye", "width": 520, "height": 900, "minWidth": 380, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src https://firestore.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
